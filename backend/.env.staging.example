# Copy into the staging secret store or a private, ignored backend env file.
# Never use production endpoints, credentials, sender accounts, or data.
NODE_ENV=production
PORT=10000

# Dedicated isolated staging MySQL database only.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# Generate a unique staging value; do not reuse any local or production key.
JWT_SECRET=
FRONTEND_URL=https://lux-energy-staging-web.onrender.com
CORS_ALLOWED_ORIGINS=https://lux-energy-staging-web.onrender.com

# Free Render filesystems are ephemeral; these paths do not provide persistence.
UPLOADS_DIR=./uploads
PRIVATE_UPLOADS_DIR=./private_uploads

# Mailtrap email sandbox; use sandbox credentials, never a production sender.
EMAIL_MODE=local
EMAIL_LOCAL_PROVIDER=mailtrap
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Configure an authorized SMS sandbox only if SMS staging tests are approved.
INFOBIP_API_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SMS_SENDER=ServiceSMS
# Alternative provider (do not mix with Infobip unless explicitly configured):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

REPORT_TIMEZONE=Africa/Kigali
