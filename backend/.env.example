DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=lux_energy_db
JWT_SECRET=your_jwt_secret_key_change_this
PORT=5000
NODE_ENV=development
EMAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lux Energy <no-reply@your-verified-domain.com>"
# Local-only alternatives. Set EMAIL_MODE=local explicitly to enable either option.
EMAIL_LOCAL_PROVIDER=mailpit
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
# For the Mailtrap sandbox, set EMAIL_LOCAL_PROVIDER=mailtrap and fill SMTP_HOST/PORT/USER/PASS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_FROM_NUMBER must be an SMS-capable number in E.164 format, e.g. +1... or +250...
# Infobip is preferred when configured; Twilio remains a fallback provider.
INFOBIP_API_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SMS_SENDER=ServiceSMS
FRONTEND_URL=http://localhost:3002
REPORT_REMINDER_CRON=0 18 * * *
REPORT_TIMEZONE=Africa/Kigali